--4.1. Tabla USUARIO
CREATE TABLE USUARIO (
    ID_USUARIO NUMBER GENERATED BY DEFAULT AS IDENTITY,
    USERNAME VARCHAR2(50) NOT NULL,
    PASSWORD_HASH VARCHAR2(255) NOT NULL,
    CORREO VARCHAR2(150) NOT NULL,
    NOMBRE VARCHAR2(100),
    APELLIDO VARCHAR2(100),
    ESTADO VARCHAR2(15) DEFAULT 'ACTIVO' NOT NULL,
    FECHA_CREACION TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,
    FECHA_ACTUALIZACION TIMESTAMP,

    CONSTRAINT PK_USUARIO
        PRIMARY KEY (ID_USUARIO),

    CONSTRAINT UK_USUARIO_USERNAME
        UNIQUE (USERNAME),

    CONSTRAINT UK_USUARIO_CORREO
        UNIQUE (CORREO),

    CONSTRAINT CK_USUARIO_ESTADO
        CHECK (ESTADO IN ('ACTIVO', 'BLOQUEADO', 'INACTIVO'))
);

--4.2. Tabla ROL
CREATE TABLE ROL (
    ID_ROL NUMBER GENERATED BY DEFAULT AS IDENTITY,
    NOMBRE VARCHAR2(50) NOT NULL,
    DESCRIPCION VARCHAR2(250),
    ESTADO VARCHAR2(15) DEFAULT 'ACTIVO' NOT NULL,
    FECHA_CREACION TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,

    CONSTRAINT PK_ROL PRIMARY KEY (ID_ROL),
    CONSTRAINT UK_ROL_NOMBRE UNIQUE (NOMBRE),
    CONSTRAINT CK_ROL_ESTADO
        CHECK (ESTADO IN ('ACTIVO', 'INACTIVO'))
);
--4.3. Tabla PERMISO
CREATE TABLE PERMISO (
    ID_PERMISO NUMBER GENERATED BY DEFAULT AS IDENTITY,
    CODIGO VARCHAR2(80) NOT NULL,
    NOMBRE VARCHAR2(100) NOT NULL,
    DESCRIPCION VARCHAR2(250),
    ESTADO VARCHAR2(15) DEFAULT 'ACTIVO' NOT NULL,

    CONSTRAINT PK_PERMISO PRIMARY KEY (ID_PERMISO),
    CONSTRAINT UK_PERMISO_CODIGO UNIQUE (CODIGO),
    CONSTRAINT CK_PERMISO_ESTADO
        CHECK (ESTADO IN ('ACTIVO', 'INACTIVO'))
);
--4.4. Tabla USUARIO_ROL
CREATE TABLE USUARIO_ROL (
    ID_USUARIO NUMBER NOT NULL,
    ID_ROL NUMBER NOT NULL,
    FECHA_ASIGNACION TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,

    CONSTRAINT PK_USUARIO_ROL
        PRIMARY KEY (ID_USUARIO, ID_ROL),

    CONSTRAINT FK_USUARIO_ROL_USUARIO
        FOREIGN KEY (ID_USUARIO)
        REFERENCES USUARIO (ID_USUARIO),

    CONSTRAINT FK_USUARIO_ROL_ROL
        FOREIGN KEY (ID_ROL)
        REFERENCES ROL (ID_ROL)
);
--4.5. Tabla ROL_PERMISO
CREATE TABLE ROL_PERMISO (
    ID_ROL NUMBER NOT NULL,
    ID_PERMISO NUMBER NOT NULL,
    FECHA_ASIGNACION TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,

    CONSTRAINT PK_ROL_PERMISO
        PRIMARY KEY (ID_ROL, ID_PERMISO),

    CONSTRAINT FK_ROL_PERMISO_ROL
        FOREIGN KEY (ID_ROL)
        REFERENCES ROL (ID_ROL),

    CONSTRAINT FK_ROL_PERMISO_PERMISO
        FOREIGN KEY (ID_PERMISO)
        REFERENCES PERMISO (ID_PERMISO)
);
--4.6. Tabla USUARIO_MFA
CREATE TABLE USUARIO_MFA (
    ID_USUARIO NUMBER NOT NULL,
    TIPO_MFA VARCHAR2(20) NOT NULL,
    SECRETO_CIFRADO VARCHAR2(1000),
    HABILITADO CHAR(1) DEFAULT 'N' NOT NULL,
    FECHA_ACTIVACION TIMESTAMP,
    FECHA_ACTUALIZACION TIMESTAMP,

    CONSTRAINT PK_USUARIO_MFA
        PRIMARY KEY (ID_USUARIO),

    CONSTRAINT FK_USUARIO_MFA_USUARIO
        FOREIGN KEY (ID_USUARIO)
        REFERENCES USUARIO (ID_USUARIO),

    CONSTRAINT CK_USUARIO_MFA_TIPO
        CHECK (TIPO_MFA IN ('TOTP', 'EMAIL')),

    CONSTRAINT CK_USUARIO_MFA_HABILITADO
        CHECK (HABILITADO IN ('S', 'N'))
);

--4.7. Tabla SESION_USUARIO
CREATE TABLE SESION_USUARIO (
    ID_SESION NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_USUARIO NUMBER NOT NULL,
    REFRESH_TOKEN_HASH VARCHAR2(255) NOT NULL,
    FECHA_CREACION TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,
    FECHA_EXPIRACION TIMESTAMP NOT NULL,
    FECHA_REVOCACION TIMESTAMP,
    IP_ORIGEN VARCHAR2(45),
    DISPOSITIVO VARCHAR2(250),

    CONSTRAINT PK_SESION_USUARIO PRIMARY KEY (ID_SESION),

    CONSTRAINT FK_SESION_USUARIO
        FOREIGN KEY (ID_USUARIO)
        REFERENCES USUARIO (ID_USUARIO),

    CONSTRAINT UK_SESION_TOKEN
        UNIQUE (REFRESH_TOKEN_HASH)
);

--4.8. Tabla TOKEN_RECUPERACION
CREATE TABLE TOKEN_RECUPERACION (
    ID_TOKEN NUMBER GENERATED BY DEFAULT AS IDENTITY,
    ID_USUARIO NUMBER NOT NULL,
    TOKEN_HASH VARCHAR2(255) NOT NULL,
    FECHA_CREACION TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,
    FECHA_EXPIRACION TIMESTAMP NOT NULL,
    FECHA_UTILIZACION TIMESTAMP,

    CONSTRAINT PK_TOKEN_RECUPERACION
        PRIMARY KEY (ID_TOKEN),

    CONSTRAINT FK_TOKEN_RECUPERACION_USUARIO
        FOREIGN KEY (ID_USUARIO)
        REFERENCES USUARIO (ID_USUARIO),

    CONSTRAINT UK_TOKEN_RECUPERACION_HASH
        UNIQUE (TOKEN_HASH)
);

