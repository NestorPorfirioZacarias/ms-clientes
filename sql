--Consulta 3. Consultar todos los usuarios
SELECT
    ID_USUARIO,
    USERNAME,
    CORREO,
    NOMBRE,
    APELLIDO,
    ESTADO,
    FECHA_CREACION
FROM USUARIO
ORDER BY ID_USUARIO;

--4. Consultar los roles de un usuario
SELECT
    U.ID_USUARIO,
    U.USERNAME,
    R.ID_ROL,
    R.NOMBRE AS ROL
FROM USUARIO U
INNER JOIN USUARIO_ROL UR
    ON U.ID_USUARIO = UR.ID_USUARIO
INNER JOIN ROL R
    ON UR.ID_ROL = R.ID_ROL
WHERE U.ID_USUARIO = 1;

--Consulta 5. Consultar los permisos de un usuario
SELECT DISTINCT
    U.USERNAME,
    R.NOMBRE AS ROL,
    P.CODIGO AS PERMISO
FROM USUARIO U
INNER JOIN USUARIO_ROL UR
    ON U.ID_USUARIO = UR.ID_USUARIO
INNER JOIN ROL R
    ON UR.ID_ROL = R.ID_ROL
INNER JOIN ROL_PERMISO RP
    ON R.ID_ROL = RP.ID_ROL
INNER JOIN PERMISO P
    ON RP.ID_PERMISO = P.ID_PERMISO
WHERE U.ID_USUARIO = 1
  AND R.ESTADO = 'ACTIVO'
  AND P.ESTADO = 'ACTIVO';

--Consulta 6. Consultar usuarios bloqueados
SELECT
    ID_USUARIO,
    USERNAME,
    CORREO,
    ESTADO
FROM USUARIO
WHERE ESTADO = 'BLOQUEADO';

--Consulta 7. Consultar sesiones activas
SELECT
    S.ID_SESION,
    U.USERNAME,
    S.FECHA_CREACION,
    S.FECHA_EXPIRACION,
    S.IP_ORIGEN
FROM SESION_USUARIO S
INNER JOIN USUARIO U
    ON S.ID_USUARIO = U.ID_USUARIO
WHERE S.FECHA_REVOCACION IS NULL
  AND S.FECHA_EXPIRACION > SYSTIMESTAMP;

--Consulta 8. Revocar una sesión
UPDATE SESION_USUARIO
SET FECHA_REVOCACION = SYSTIMESTAMP
WHERE ID_SESION = 1
  AND FECHA_REVOCACION IS NULL;

COMMIT;



